# Groq API key used for resume/job-fit analysis and outreach generation.
GROQ_API_KEY=gsk_your-key-here

# Model id to use for analysis + outreach generation.
GROQ_MODEL=openai/gpt-oss-120b

# SQLite database file path (relative to backend/ or absolute).
DATABASE_URL=sqlite:///./mypm.db

# Comma-separated list of origins allowed to call this API (for CORS).
CORS_ORIGINS=http://localhost:3000
